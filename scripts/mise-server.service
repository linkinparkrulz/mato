# Install to /etc/systemd/system/mise-server.service (step 2 only).
# The self-service backend. Runs as the deploy user, bound to localhost; nginx
# reverse-proxies /api/ to it. Needs Tor (for the connection gate) and the
# server/ dependencies installed (cd server && npm ci).
[Unit]
Description=mise self-service submission backend
After=tor.service network-online.target mise-gateway.service
Wants=tor.service
# The gateway owns the shop's key and answers over a unix socket. Wants rather
# than Requires: the backend serves the catalogue and the directory perfectly
# well while the gateway is down, and reports it as unavailable where it
# matters, which beats refusing to start the whole site.
Wants=mise-gateway.service

[Service]
Type=simple
User=mise
Group=mise
WorkingDirectory=/var/www/mise/server
# BASE_URL MUST be the site's public origin (its .onion), used for the Auth47
# callback and resource. Set it to your hidden-service address.
Environment=PORT=8787
Environment=BASE_URL=http://YOURONIONADDRESS.onion
Environment=TOR_SOCKS_PORT=9050
# Comma-separated BIP47 payment codes allowed to moderate at /admin. Per-operator.
Environment=ADMIN_PAYMENT_CODES=ADMINPAYMENTCODE
ExecStart=/usr/bin/node index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
